{
  "name": "casino-card-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib",
    "typecheck": "tsc --noEmit",
    "mobile": "npm run start --workspace @casino/mobile",
    "mobile:android": "npm run android --workspace @casino/mobile",
    "mobile:ios": "npm run ios --workspace @casino/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @casino/mobile",
    "test": "node scripts/test-all.mjs",
    "api:start": "npm run start --workspace @casino/api",
    "api:stop": "npm run stop --workspace @casino/api",
    "api:typecheck": "npm run typecheck --workspace @casino/api",
    "api:test": "npm run test --workspace @casino/api"
  },
  "dependencies": {
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.6",
    "typescript": "^5.9.2",
    "@tailwindcss/postcss": "^4.1.13"
  },
  "workspaces": [
    "apps/mobile",
    "apps/api"
  ]
}
